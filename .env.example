# Authentication secret key (any strong random string)
JWT_SECRET=super-secret-cca-f-prep-key-change-in-production

# App base URL (optional, defaults to request origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Cloud Database connection (Turso LibSQL / Neon / Supabase / Postgres)
